{
  "name": "word-flip-app",
  "version": "1.0.0",
  "description": "The client for Wordsmith's premium word-flipping service.",
  "repository": {
    "type": "git",
    "url": "https://github.com/silkfire/word-flip-app.git"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "typecheck": "bunx tsc --noEmit",
    "prettier": "bunx prettier --write \"src/**/*.{ts,tsx,js,jsx}\"",
    "build:prod": "bunx tsc --noEmit && API_URL=https://localhost:8080/ bunx --bun vite build",
    "build:x": "bunx --no-env-file --env-file=.env.production --bun vite build -d",
    "start:prod": "bun server.ts"
  },
  "keywords": [],
  "author": "Gabriel Bider",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/compress": "^9.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/vite": "^9.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fastify": "^5.10.0",
    "javascript-time-ago": "^2.6.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-time-ago": "^7.4.4"
  },
  "overrides": {
    "react": "^19.2.0",
    "@fastify/static": "^10.1.2",
    "@isaacs/brace-expansion": "^5.0.1",
    "ajv": "^8.20.0",
    "defu": "^6.1.7",
    "fast-uri": "^3.1.3",
    "minimatch": "^10.2.6",
    "path-to-regexp": "^8.4.2"
  },
  "devDependencies": {
    "@julr/vite-plugin-validate-env": "^2.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "bun-types": "^1.3.14",
    "pino-pretty": "^13.1.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "trustedDependencies": [
    "@swc/core"
  ]
}
